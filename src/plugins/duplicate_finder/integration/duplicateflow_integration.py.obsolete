except Exception as e:
    logger.warning(f"⚠️ DuplicateFlow not available: {e}")
    DUPLICATEFLOW_AVAILABLE = False


def get_duplicateflow_presets() -> Dict[str, Dict]:
    """
    Get all DuplicateFlow presets in PipelineManager format.

    Returns:
        Dict mapping preset IDs to pipeline configurations
    """
    if not DUPLICATEFLOW_AVAILABLE:
        return {}

    try:
        presets = {}
        for preset_name in list_presets():
            preset_config = get_preset(preset_name)

            # Convert to PipelineManager format
            methods = []
            for step in preset_config.get('steps', []):
                algo_name = step.get('algorithm', '')
                methods.append({
                    'name': f'df_{algo_name}',  # Prefix with 'df_'
                    'enabled': True,
                    'weight': step.get('weight', 1.0),
                    'parameters': step.get('params', {})
                })

            presets[f'df_{preset_name}'] = {
                'name': f'🚀 {preset_name.title()} (DuplicateFlow)',
                'description': f'DuplicateFlow {preset_name} preset - {len(methods)} algorithms',
                'mode': 'weighting',  # DuplicateFlow uses weighted scoring
                'methods': methods,
                'global_threshold': preset_config.get('global_threshold', 70.0),
                'source': 'duplicateflow'
            }

        logger.info(f"✅ Loaded {len(presets)} DuplicateFlow presets")
        return presets

    except Exception as e:
        logger.error(f"❌ Failed to load DuplicateFlow presets: {e}")
        return {}


def get_all_algorithms() -> Dict[str, Dict]:
    """
    Get all algorithms (local + DuplicateFlow).

    Returns:
        Dict of algorithm definitions in VerificationPipeline format
    """
    return DUPLICATEFLOW_ALGORITHMS.copy()


def is_duplicateflow_algorithm(method_name: str) -> bool:
    """Check if a method is from DuplicateFlow."""
    return method_name.startswith('df_')


# Module info
__all__ = [
    'DUPLICATEFLOW_AVAILABLE',
    'DUPLICATEFLOW_ALGORITHMS',
    'get_duplicateflow_presets',
    'get_all_algorithms',
    'is_duplicateflow_algorithm',
]
