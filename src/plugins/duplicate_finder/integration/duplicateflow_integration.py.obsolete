"""
DuplicateFlow Integration Module

This module bridges the gap between the local VerificationPipeline system
and DuplicateFlow's 14 algorithms, allowing the UnifiedPipelineEditor to
access and configure both local and DuplicateFlow algorithms seamlessly.

Architecture:
- Loads DuplicateFlow algorithms dynamically
- Maps them to VerificationPipeline format (AVAILABLE_METHODS)
- Provides unified interface for both systems
- Falls back gracefully if DuplicateFlow is not available
"""

import sys
import logging
from typing import Dict, List, Optional, Any
from pathlib import Path

